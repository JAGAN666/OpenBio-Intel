# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
#
# Only OPENAI_API_KEY and ANTHROPIC_API_KEY are required for the default
# setup. Everything else is optional and only matters if you're using the
# specific feature it powers (see the comment above each section).

# =============================================================================
# REQUIRED
# =============================================================================

# Powers every embedding call (text-embedding-3-small, used by ALL retrieval
# paths) and the pinned gpt-4o structured-extraction stage (Smart Table's
# per-trial Map workers, the Landscape matrix, and the Catalyst timeline).
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default LLM provider for agent orchestration/routing (tool-calling,
# intent classification, narrative synthesis). Not needed if you set
# LLM_PROVIDER=kimi or LLM_PROVIDER=nvidia below instead.
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# =============================================================================
# OPTIONAL -- alternate LLM providers for orchestration/routing
# =============================================================================

# "anthropic" (default, uses ANTHROPIC_API_KEY above), "kimi", or "nvidia".
# This only affects orchestration/routing calls -- the gpt-4o-pinned
# structured-extraction stage always uses OPENAI_API_KEY regardless, since
# that call shape (dozens of parallel calls per query) needs a provider
# tier that can sustain real concurrency.
# LLM_PROVIDER=anthropic

# Only used if LLM_PROVIDER=kimi. Get a key: https://platform.moonshot.ai
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k3

# Only used if LLM_PROVIDER=nvidia, or as the judge model for
# evaluate_agent.py's Ragas faithfulness scoring. Free tier available at
# https://build.nvidia.com
# NVIDIA_API_KEY=
# NVIDIA_MODEL=

# =============================================================================
# OPTIONAL -- Qdrant / Neo4j connection (defaults already match
# docker-compose.yml's service names; only override for a non-Compose setup)
# =============================================================================

# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# =============================================================================
# OPTIONAL -- feature-specific ingestion credentials
# =============================================================================

# Only for PDF ingestion (parse_pdfs.py / ingest_pipeline.py) -- conference
# posters and FDA-filing PDFs parsed via vision-based table extraction.
# Get a key: https://cloud.llamaindex.ai
# LLAMA_CLOUD_API_KEY=

# Only for PubMed ingestion (fetch_pubmed.py). NCBI's E-utilities work
# without a key at a lower rate limit; both are optional, but NCBI asks
# for an identifying email as a courtesy for any automated use of its API.
# NCBI_API_KEY=
# NCBI_ENTREZ_EMAIL=you@example.com

# Only for SEC EDGAR ingestion (fetch_sec_edgar.py). SEC EDGAR's own fair-
# access policy requires every automated requester to identify itself with
# a company name and contact email -- this is SEC's requirement, not this
# project's.
# SEC_EDGAR_COMPANY=
# SEC_EDGAR_EMAIL=

# Only if archiving raw ingestion payloads to S3 (omit --skip-s3 on the
# fetch/seed scripts). Not needed for local evaluation via quickstart.sh,
# which always runs with --skip-s3. AWS credentials themselves are read by
# boto3's normal resolution order -- ~/.aws/credentials (recommended) or
# the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN env
# vars below both work.
# S3_BUCKET=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# =============================================================================
# OPTIONAL -- advanced overrides, rarely needed
# =============================================================================

# Override the model used for the Landscape / Catalyst / Smart-Table
# extraction stages (all pinned to OpenAI gpt-4o by default -- see
# research_agent.py's _build_gpt4o_llm docstring for why).
# LANDSCAPE_MODEL=gpt-4o
# CATALYST_MODEL=gpt-4o
# EXTRACTION_MODEL=gpt-4o

# Explicit path to a Python interpreter with scispacy installed, for
# knowledge-graph entity resolution during ingestion. Only needed if you're
# NOT using docker-compose.yml's seed/etl service (which already has
# scispacy baked in) -- e.g. running fetch_pubmed.py or
# fetch_daily_updates.py directly against a bare-metal Python environment.
# Defaults to ./.venv-kg/bin/python if that exists, else falls back to
# skipping entity resolution.
# KG_PYTHON=

# auth.py's JWT validation module is present but currently UNUSED by
# api.py (no login/token-issuing flow exists yet -- see auth.py's own
# module docstring). These only matter if you wire authentication back in.
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
